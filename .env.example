# Server
PORT=3000

# ── Daily Briefing: Email ────────────────────────────────────────────────────
# Gmail: enable 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords
# Other providers: update SMTP_HOST/PORT/SECURE accordingly
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
BRIEFING_TO=you@example.com
BRIEFING_FROM=Chaotic Era Briefing <your-gmail@gmail.com>

# ── Daily Briefing: Schedule ─────────────────────────────────────────────────
BRIEFING_HOUR=6
BRIEFING_TIMEZONE=America/New_York

# ── Daily Briefing: SMS via Twilio (optional) ────────────────────────────────
# Sign up at https://twilio.com, get a phone number, then fill in:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_TO_NUMBER=+1xxxxxxxxxx
