# Server
PORT=3000

# ── Daily Briefing: Email via Resend ─────────────────────────────────────────
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BRIEFING_TO=you@example.com
# Before domain verification, use: onboarding@resend.dev
# After verifying your domain in Resend: Chaotic Era Briefing <briefing@yourdomain.com>
BRIEFING_FROM=Chaotic Era Briefing <onboarding@resend.dev>

# ── Daily Briefing: Schedule ─────────────────────────────────────────────────
BRIEFING_HOUR=6
BRIEFING_TIMEZONE=America/New_York

# ── Daily Briefing: SMS via Twilio (optional) ────────────────────────────────
# Sign up at https://twilio.com, get a phone number, then fill in:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_TO_NUMBER=+1xxxxxxxxxx
